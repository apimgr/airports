{{define "header"}}
<div class="header-container">
    <a class="logo" href="{{.BaseURL}}/">{{if .LogoURL}}<img src="{{.LogoURL}}"{{if .LogoSrcSet}} srcset="{{.LogoSrcSet}}" sizes="(max-width: 600px) 50px, 200px"{{end}} alt="{{.BrandTitle}}">{{else}}{{.BrandTitle}}{{end}}</a>
    {{template "nav" .}}
    <label class="nav-toggle" for="nav-toggle" aria-controls="nav-panel" aria-label="{{t "nav.open_navigation"}}">☰</label>
    <div class="header-actions">
        <a class="preferences-link" href="{{.BaseURL}}/server/preferences" {{if eq .CanonicalURL (printf "%s/server/preferences" .BaseURL)}}aria-current="page"{{end}}>{{t "nav.preferences"}}</a>
        <form class="theme-toggle-form" method="post" action="{{.BaseURL}}/server/preferences">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="theme" value="{{nextTheme .Theme}}">
            <button class="theme-button" type="submit" aria-label="{{tf "theme.switch_current" "theme" (themeLabel .Theme)}}" title="{{t "theme.switch"}}">
                <svg class="icon-dark" viewBox="0 0 24 24" aria-hidden="true" focusable="false" {{if ne .Theme "dark"}}hidden{{end}}>
                    <path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
                </svg>
                <svg class="icon-light" viewBox="0 0 24 24" aria-hidden="true" focusable="false" {{if ne .Theme "light"}}hidden{{end}}>
                    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
                    <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                </svg>
                <svg class="icon-auto" viewBox="0 0 24 24" aria-hidden="true" focusable="false" {{if ne .Theme "auto"}}hidden{{end}}>
                    <path d="M12 2a10 10 0 1 0 0 20V2Z" fill="currentColor"></path>
                    <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle>
                </svg>
            </button>
        </form>
    </div>
</div>
{{operatorHTML "header"}}
{{end}}
