{{define "head"}}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{.Description}}">
    {{if .Keywords}}<meta name="keywords" content="{{.Keywords}}">{{end}}
    {{if .SEOAuthor}}<meta name="author" content="{{.SEOAuthor}}">{{end}}
    <meta name="robots" content="{{.Robots}}">
    <title>{{.Title}}{{.TitleSeparator}}{{.BrandTitle}}{{if .BrandTagline}} - {{.BrandTagline}}{{end}}</title>
    <link rel="canonical" href="{{.CanonicalURL}}">
    {{range .MetaTags}}<meta name="{{.Name}}" content="{{.Content}}">{{end}}
    {{range .VerificationTags}}{{if .Name}}<meta name="{{.Name}}" content="{{.Content}}">{{else}}<meta property="{{.Property}}" content="{{.Content}}">{{end}}{{end}}
    {{if .OpenGraphEnabled}}
    <meta property="og:title" content="{{.Title}}{{.TitleSeparator}}{{.BrandTitle}}">
    <meta property="og:description" content="{{.Description}}">
    {{if .OGImage}}<meta property="og:image" content="{{.OGImage}}">{{end}}
    <meta property="og:type" content="{{.OpenGraphType}}">
    <meta property="og:url" content="{{.CanonicalURL}}">
    <meta property="og:site_name" content="{{.OpenGraphSiteName}}">
    {{end}}
    {{if .TwitterEnabled}}
    <meta name="twitter:card" content="{{.TwitterCard}}">
    <meta name="twitter:title" content="{{.Title}}{{.TitleSeparator}}{{.BrandTitle}}">
    <meta name="twitter:description" content="{{.Description}}">
    {{if .OGImage}}<meta name="twitter:image" content="{{.OGImage}}">{{end}}
    {{if .TwitterHandle}}<meta name="twitter:site" content="{{.TwitterHandle}}">{{end}}
    {{if .TwitterCreator}}<meta name="twitter:creator" content="{{.TwitterCreator}}">{{end}}
    {{end}}
    <link rel="stylesheet" href="{{.BaseURL}}/static/css/common.css">
    <link rel="stylesheet" href="{{.BaseURL}}/static/css/components.css">
    <link rel="stylesheet" href="{{.BaseURL}}/static/css/public.css">
    {{if .SwaggerUI}}<link rel="stylesheet" href="{{.BaseURL}}/server/docs/swagger/assets/swagger-ui.css"><link rel="stylesheet" href="{{.BaseURL}}/server/docs/swagger/theme.css">{{end}}
    {{if .GraphiQLUI}}<link rel="stylesheet" href="{{.BaseURL}}/server/docs/graphql/assets/graphiql.min.css"><link rel="stylesheet" href="{{.BaseURL}}/server/docs/graphql/theme.css">{{end}}
    {{if .AccentCSS}}<link rel="stylesheet" href="{{.BaseURL}}/static/css/accent.css">{{end}}
    <link rel="icon" type="image/png" href="{{.Favicon16URL}}" sizes="16x16">
    <link rel="icon" type="image/png" href="{{.FaviconURL}}" sizes="32x32">
    <link rel="icon" type="image/png" href="{{.Favicon48URL}}" sizes="48x48">
    <link rel="icon" type="image/png" href="{{.Favicon192URL}}" sizes="192x192">
    <link rel="icon" type="image/png" href="{{.Favicon512URL}}" sizes="512x512">
    <link rel="apple-touch-icon" href="{{.AppleTouchIconURL}}">
    <link rel="manifest" href="{{.BaseURL}}/manifest.webmanifest">
    <meta name="theme-color" content="{{.ThemeColor}}">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <!-- Structured Data (AI.md PART 16 SEO meta tags) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "{{.BrandTitle}}",
      "description": "{{.Description}}",
      "url": "{{.CanonicalURL}}"
    }
    </script>
    {{if .TrackingEnabled}}
    <script defer src="{{.BaseURL}}/static/js/analytics.js" data-provider="{{.TrackingType}}" data-id="{{.TrackingID}}" data-url="{{.TrackingURL}}"></script>
    {{if .TrackingSimple}}<noscript><img src="https://queue.simpleanalyticscdn.com/noscript.gif" alt="" referrerpolicy="no-referrer-when-downgrade"></noscript>{{end}}
    {{end}}
</head>
{{end}}
