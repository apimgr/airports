{{define "content"}}
<div class="container container-md">
    <header class="page-header">
        <h1 class="page-title">{{t "privacy.title"}}</h1>
        <p class="page-lead">{{t "privacy.intro"}}</p>
        {{if ne .BuildDate "unknown"}}<p class="form-help">{{tf "common.last_updated" "datetime" .BuildDate}}</p>{{end}}
    </header>

    <section id="summary" class="section-card" aria-labelledby="privacy-summary">
        <h2 id="privacy-summary">{{t "privacy.summary_heading"}}</h2>
        {{if .Privacy.Data.StoredOnServer}}
        <p>{{t "privacy.stored_on_server"}}</p>
        {{else}}
        <p>{{t "privacy.not_stored_on_server"}}</p>
        {{end}}
        {{if .Privacy.Data.Sold}}
        <p class="alert alert-warning" role="status">{{t "privacy.data_sold"}} <a href="#ccpa-opt-out">{{t "privacy.ccpa_opt_out"}}</a></p>
        {{else}}
        <p>{{t "privacy.data_not_sold"}}</p>
        {{end}}
    </section>

    <section class="section-card" aria-labelledby="privacy-cookies">
        <h2 id="privacy-cookies">{{t "privacy.cookies_heading"}}</h2>
        <p>{{.PrivacyText.ConsentMessage}}</p>
        <h3>{{t "privacy.cookie_categories"}}</h3>
        <ul>
            <li><strong>{{t "privacy.essential_label"}}:</strong> {{.PrivacyText.EssentialCookieDescription}}</li>
            <li><strong>{{t "privacy.preferences_label"}}:</strong> {{.PrivacyText.PreferencesCookieDescription}}</li>
            <li><strong>{{t "privacy.analytics_label"}}:</strong> {{.PrivacyText.AnalyticsCookieDescription}}</li>
        </ul>
        <p>{{t "privacy.cookie_note"}}</p>
    </section>

    <section class="section-card" aria-labelledby="privacy-collection">
        <h2 id="privacy-collection">{{t "privacy.collect_heading"}}</h2>
        <h3>{{t "privacy.collect_logs_label"}}</h3>
        <p>{{t "privacy.collect_logs_desc"}}</p>
        <h3>{{t "privacy.collect_geoip_label"}}</h3>
        <p>{{t "privacy.collect_geoip_desc"}}</p>
        <h3>{{t "privacy.not_collect_heading"}}</h3>
        <ul>
            <li>{{t "privacy.not_collect_accounts"}}</li>
            <li>{{t "privacy.not_collect_cookies"}}</li>
            <li>{{t "privacy.not_collect_analytics"}}</li>
        </ul>
    </section>

    <section class="section-card" aria-labelledby="privacy-usage">
        <h2 id="privacy-usage">{{t "privacy.data_usage_heading"}}</h2>
        {{.PrivacyText.DataUsage | markdownToHTML}}
    </section>

    <section class="section-card" aria-labelledby="privacy-security">
        <h2 id="privacy-security">{{t "privacy.data_security_heading"}}</h2>
        {{.PrivacyText.DataSecurity | markdownToHTML}}
    </section>

    <section class="section-card" aria-labelledby="privacy-storage">
        <h2 id="privacy-storage">{{t "privacy.data_storage_heading"}}</h2>
        {{if .Privacy.Data.StoredOnServer}}
        <p>{{t "privacy.stored_on_server"}}</p>
        {{else}}
        <p>{{t "privacy.not_stored_on_server"}}</p>
        {{end}}
        <h3>{{t "privacy.sharing_heading"}}</h3>
        {{if .PrivacyText.Sharing}}
        <ul>
            {{range .PrivacyText.Sharing}}
            <li>{{.Description}}</li>
            {{end}}
        </ul>
        {{else}}
        <p>{{t "privacy.no_sharing"}}</p>
        {{end}}
        {{if .Privacy.Data.Sold}}
        <p>{{t "privacy.data_sold"}}</p>
        {{else}}
        <p>{{t "privacy.data_not_sold"}}</p>
        {{end}}
    </section>

    <section class="section-card" aria-labelledby="privacy-retention">
        <h2 id="privacy-retention">{{t "privacy.retention_heading"}}</h2>
        <p>{{.PrivacyText.RetentionPeriod}}</p>
    </section>

    <section class="section-card" aria-labelledby="privacy-third-parties">
        <h2 id="privacy-third-parties">{{t "privacy.third_party_heading"}}</h2>
        <p>{{t "privacy.third_party_desc"}}</p>
        {{if .ThirdPartyServices}}
        <div class="table-wrapper">
            <table class="data-table">
                <caption>{{t "privacy.third_party_heading"}}</caption>
                <thead><tr><th scope="col">{{t "privacy.service_label"}}</th><th scope="col">{{t "privacy.purpose_label"}}</th><th scope="col">{{t "privacy.data_sent_label"}}</th><th scope="col">{{t "privacy.policy_label"}}</th></tr></thead>
                <tbody>
                    {{range .ThirdPartyServices}}
                    <tr><td>{{.Name}}</td><td>{{.Purpose}}</td><td>{{.DataSent}}</td><td>{{if .PolicyURL}}<a href="{{.PolicyURL}}" rel="noopener noreferrer">{{t "privacy.view_policy"}}</a>{{else}}{{t "privacy.policy_not_provided"}}{{end}}</td></tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        {{else}}
        <p>{{t "privacy.no_third_parties"}}</p>
        {{end}}
    </section>

    <section class="section-card" aria-labelledby="privacy-rights">
        <h2 id="privacy-rights">{{t "privacy.rights_heading"}}</h2>
        <ul>
            {{if .Privacy.Retention.ExportAvailable}}<li>{{t "privacy.export_right"}}</li>{{end}}
            {{if .Privacy.Retention.DeletionAvailable}}<li>{{t "privacy.deletion_right"}}</li>{{end}}
            <li>{{t "privacy.cookie_right"}}</li>
        </ul>
        <button type="button" class="btn btn-secondary" data-action="cookie-preferences">{{t "privacy.manage_preferences"}}</button>
    </section>

    {{if .Privacy.Data.Sold}}
    <section id="ccpa-opt-out" class="section-card" aria-labelledby="privacy-ccpa">
        <h2 id="privacy-ccpa">{{t "privacy.ccpa_heading"}}</h2>
        <p>{{t "privacy.ccpa_description"}}</p>
        {{if .CCPAOptedOut}}<p class="alert alert-success" role="status">{{t "privacy.ccpa_opted_out"}}</p>{{end}}
        {{if .CCPAOptedOut}}
        <form method="post" action="/server/ccpa">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="choice" value="opt-in">
            <button type="submit" class="btn btn-secondary">{{t "privacy.ccpa_opt_in"}}</button>
        </form>
        {{else}}
        <form method="post" action="/server/ccpa">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="choice" value="opt-out">
            <button type="submit" class="btn btn-primary">{{t "privacy.ccpa_opt_out"}}</button>
        </form>
        {{end}}
    </section>
    {{end}}

    {{operatorHTML "privacy"}}
    <section class="section-card" aria-labelledby="privacy-contact">
        <h2 id="privacy-contact">{{t "privacy.contact_heading"}}</h2>
        {{if .PrivacyDPOEmail}}<p><a href="mailto:{{.PrivacyDPOEmail}}">{{tf "privacy.contact" "contact" .PrivacyDPOEmail}}</a></p>{{else}}<p><a href="{{.BaseURL}}/server/security">{{tf "privacy.contact" "contact" (t "privacy.contact_security_link")}}</a></p>{{end}}
    </section>
</div>
{{end}}
