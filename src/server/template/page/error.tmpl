{{define "content"}}
<div class="container container-sm">
    <header class="page-header">
        <h1 class="page-title">{{tf "errors.status_title" "code" .StatusCode}}</h1>
        <p class="page-lead">{{.Message}}</p>
    </header>
    <section class="section-card" aria-labelledby="error-code">
        <h2 id="error-code">{{tf "errors.status_code" "code" .StatusCode}}</h2>
        <p><a href="{{.BaseURL}}/" class="btn btn-secondary">{{t "errors.return_home"}}</a></p>
    </section>
</div>
{{end}}
