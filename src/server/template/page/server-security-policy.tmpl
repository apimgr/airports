{{define "content"}}
<div class="container container-md">
    <header class="page-header">
        <h1 class="page-title">{{t "security.policy_title"}}</h1>
        <p class="page-lead">{{t "security.policy_lead"}}</p>
    </header>
    <section class="section-card" aria-labelledby="security-disclosure-policy">
        <h2 id="security-disclosure-policy">{{t "security.disclosure_heading"}}</h2>
        {{if .Policy}}
        {{.Policy | markdownToHTML}}
        {{else}}
        <p>{{t "security.default_policy"}}</p>
        {{end}}
    </section>
    <section class="section-card" aria-labelledby="security-research">
        <h2 id="security-research">{{t "security.research_heading"}}</h2>
        <p>{{t "security.research_guidance"}}</p>
    </section>
    <section class="section-card" aria-labelledby="security-disclosure">
        <h2 id="security-disclosure">{{t "security.coordinated_heading"}}</h2>
        <p>{{t "security.coordinated_guidance"}}</p>
        <p><a href="{{.BaseURL}}/server/security">{{t "security.back_to_overview"}}</a></p>
    </section>
</div>
{{end}}
