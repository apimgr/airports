{{define "content"}}
<div class="container container-md">
    <header class="page-header">
        <h1 class="page-title">{{t "about.title"}}</h1>
        <p class="page-lead">{{.Tagline}}</p>
    </header>

    <section class="section-card" aria-labelledby="about-description">
        <h2 id="about-description">{{t "about.what_heading"}}</h2>
        <p>{{.Description}}</p>
    </section>

    <section class="section-card" aria-labelledby="about-features">
        <h2 id="about-features">{{t "about.features_heading"}}</h2>
        <ul>{{range .Features}}<li>{{.}}</li>{{end}}</ul>
    </section>

    <section class="section-card" aria-labelledby="about-links">
        <h2 id="about-links">{{t "about.links_heading"}}</h2>
        <ul>
            <li><a href="{{.Repo}}">{{t "about.link_source"}}</a></li>
            <li><a href="{{.BaseURL}}/server/help">{{t "about.link_help"}}</a></li>
            <li><a href="{{.BaseURL}}/server/docs/swagger">{{t "about.link_swagger"}}</a></li>
            <li><a href="{{.BaseURL}}/server/docs/graphql">{{t "about.link_graphql"}}</a></li>
        </ul>
    </section>

    <section class="section-card" aria-labelledby="about-attribution">
        <h2 id="about-attribution">{{t "about.attribution_heading"}}</h2>
        <p><a href="https://ourairports.com/data/">{{t "about.airport_data_attribution"}}</a></p>
        <p>{{t "about.airport_data_snapshot"}}</p>
        <p><a href="https://github.com/mwgg/Airports">{{t "about.airport_timezone_attribution"}}</a></p>
        <p><a href="https://www.timezonedb.com/">TimeZoneDB (CC BY 3.0)</a> · <a href="https://timeapi.io/">TimeAPI</a></p>
        <p><a href="https://db-ip.com/">IP Geolocation by DB-IP</a></p>
        <p><a href="https://iptoasn.com/">{{t "about.asn_attribution"}}</a></p>
        <p>{{tf "about.license_version" "license" .License "version" .Version}}</p>
    </section>
    {{operatorHTML "about"}}
</div>
{{end}}
