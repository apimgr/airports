{{define "content"}}
<div class="container container-lg docs-ui">
    <header class="page-header">
        <h1 class="page-title">{{t "swagger.page_title"}}</h1>
        <p class="page-lead">{{t "swagger.page_description"}}</p>
    </header>
    <section class="section-card" aria-labelledby="swagger-explorer-heading">
        <h2 id="swagger-explorer-heading">{{t "common.swagger_explorer"}}</h2>
        <div id="swagger-container">
            <div id="swagger-ui" data-spec-url="{{.SwaggerURL}}"></div>
        </div>
    </section>
    <noscript>
        <section class="section-card" aria-labelledby="swagger-noscript-heading">
            <h2 id="swagger-noscript-heading">{{t "common.javascript_required"}}</h2>
            <p>{{t "common.docs_js_fallback"}} <a href="{{.SwaggerURL}}">{{t "common.openapi_json"}}</a></p>
        </section>
    </noscript>
</div>
<script src="{{.BaseURL}}/static/vendor/swagger-ui/swagger-ui-bundle.js?v={{.AssetStamp}}"></script>
<script src="{{.BaseURL}}/static/vendor/swagger-ui/swagger-ui-standalone-preset.js?v={{.AssetStamp}}"></script>
<script src="{{.BaseURL}}/static/js/docs-swagger.js?v={{.AssetStamp}}"></script>
{{end}}
