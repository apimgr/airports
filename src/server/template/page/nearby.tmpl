{{define "content"}}
<div class="page-header">
    <h1>📍 {{t "nearby.title"}}</h1>
    <p>{{t "nearby.subtitle"}}</p>
</div>

<div class="nearby-container">
    <form method="get" action="/nearby" class="nearby-form" data-action="submit-nearby">
        <div class="form-row">
            <div class="form-group">
                <label for="latitude">{{t "nearby.latitude"}}</label>
                <input type="number" id="latitude" name="lat" step="0.0001" placeholder="40.6398"
                       value="{{.Lat}}" required>
            </div>
            <div class="form-group">
                <label for="longitude">{{t "nearby.longitude"}}</label>
                <input type="number" id="longitude" name="lon" step="0.0001" placeholder="-73.7789"
                       value="{{.Lon}}" required>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="radius">{{t "nearby.radius"}}</label>
                <input type="number" id="radius" name="radius" min="1" max="500" value="{{if .Radius}}{{.Radius}}{{else}}50{{end}}">
            </div>
            <div class="form-group">
                <label for="units">{{t "nearby.units"}}</label>
                <select id="units" name="units">
                    <option value="imperial" {{if eq .Units "imperial"}}selected{{end}}>{{t "nearby.unit_imperial"}}</option>
                    <option value="metric" {{if eq .Units "metric"}}selected{{end}}>{{t "nearby.unit_metric"}}</option>
                </select>
            </div>
            <div class="form-group">
                <label for="limit">{{t "nearby.max_results"}}</label>
                <input type="number" id="limit" name="limit" min="1" max="100" value="{{if .Limit}}{{.Limit}}{{else}}20{{end}}">
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">{{t "nearby.find_airports"}}</button>
            <button type="button" data-action="use-my-location" class="btn-secondary">{{t "nearby.use_my_location"}}</button>
        </div>
    </form>

    <div id="nearby-results">
        {{if .Airports}}
            <div class="results-info">
                {{tf "nearby.results_found" "count" (len .Airports) "radius" .DisplayRadius "unit" .RadiusUnit}}
            </div>

            <div class="results-list">
                {{range .Airports}}
                <div class="airport-result-card" data-action="view-airport" data-code="{{.ICAO}}">
                    <div class="airport-result-header">
                        <div>
                            <h3>{{.ICAO}}{{if .IATA}} / {{.IATA}}{{end}}</h3>
                            <div class="airport-name">{{.Name}}</div>
                        </div>
                        <div class="distance-badge">
                            {{printf "%.2f" .Distance}} {{.DistanceUnit}}
                        </div>
                    </div>
                    <div class="airport-result-details">
                        <span>📍 {{.City}}, {{.Country}}</span>
                        <span>✈️ {{.Elevation}} ft</span>
                        <span>🌐 {{printf "%.4f" .Lat}}, {{printf "%.4f" .Lon}}</span>
                    </div>
                </div>
                {{end}}
            </div>
        {{end}}
    </div>
</div>

{{end}}
