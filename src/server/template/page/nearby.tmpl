{{define "content"}}
<div class="page-header">
    <h1>📍 {{t "nearby.title"}}</h1>
    <p>{{t "nearby.subtitle"}}</p>
</div>

<div class="nearby-container">
    <form method="get" action="{{.BaseURL}}/airports/nearby" class="nearby-form" data-action="submit-nearby">
        <div class="form-row">
            <div class="form-group">
                <label for="latitude">{{t "nearby.latitude"}}</label>
                <input type="number" id="latitude" name="lat" step="0.0001" placeholder="40.6398"
                       value="{{.Lat}}" required>
            </div>
            <div class="form-group">
                <label for="longitude">{{t "nearby.longitude"}}</label>
                <input type="number" id="longitude" name="lon" step="0.0001" placeholder="-73.7789"
                       value="{{.Lon}}" required>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="radius">{{t "nearby.radius"}}</label>
                <input type="number" id="radius" name="radius" min="1" max="500" value="{{if .Radius}}{{.Radius}}{{else}}50{{end}}">
            </div>
            <div class="form-group">
                <label for="units">{{t "nearby.units"}}</label>
                <select id="units" name="units">
                    <option value="imperial" {{if eq .Units "imperial"}}selected{{end}}>{{t "nearby.unit_imperial"}}</option>
                    <option value="metric" {{if eq .Units "metric"}}selected{{end}}>{{t "nearby.unit_metric"}}</option>
                </select>
            </div>
            <div class="form-group">
                <label for="limit">{{t "nearby.max_results"}}</label>
                <input type="number" id="limit" name="limit" min="1" max="100" value="{{if .Limit}}{{.Limit}}{{else}}20{{end}}">
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">{{t "nearby.find_airports"}}</button>
            <button type="button" data-action="use-my-location" class="btn-secondary">{{t "nearby.use_my_location"}}</button>
        </div>
    </form>

    <div id="nearby-results">
        {{if .BBoxSearch}}
            {{if .BBoxResults}}
                <div class="results-info">{{tf "search.results_found" "count" .BBoxTotal}}</div>
                <section class="airport-map" hidden data-map-points="{{.MapJSON}}" data-map-error="{{t "airport.map_unavailable"}}" aria-label="{{t "airport.map_heading"}}">
                    <div class="map-toolbar">
                        <h3>{{t "airport.map_heading"}}</h3>
                        <div class="map-zoom-controls">
                            <button type="button" data-map-zoom="1" aria-label="{{t "airport.zoom_in"}}">+</button>
                            <button type="button" data-map-zoom="-1" aria-label="{{t "airport.zoom_out"}}">−</button>
                        </div>
                    </div>
                    <div class="map-canvas" role="region" aria-label="{{t "airport.map_heading"}}"></div>
                    <p class="map-attribution">© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap contributors</a></p>
                </section>
                <div class="results-grid">
                    {{range .BBoxResults}}
                    <article class="airport-card">
                        <div class="airport-header"><h3>{{.ICAO}}{{if .IATA}} / {{.IATA}}{{end}}</h3></div>
                        <div class="airport-name">{{.Name}}</div>
                        <div class="airport-location">{{.City}}, {{.Country}}</div>
                        <div class="airport-details"><span>{{printf "%.4f" .Lat}}, {{printf "%.4f" .Lon}}</span>
                            <a href="https://www.openstreetmap.org/?mlat={{.Lat}}&mlon={{.Lon}}#map=12/{{.Lat}}/{{.Lon}}" target="_blank" rel="noopener">{{t "airport.view_on_map"}}</a>
                        </div>
                    </article>
                    {{end}}
                </div>
                {{if gt .BBoxTotal .Limit}}<p>{{tf "search.showing_first" "shown" .Limit "total" .BBoxTotal}}</p>{{end}}
            {{else}}
                <div class="results-info">{{t "search.no_results_title"}}</div>
            {{end}}
        {{else if .Airports}}
            <div class="results-info">
                {{tf "nearby.results_found" "count" (len .Airports) "radius" .DisplayRadius "unit" .RadiusUnit}}
            </div>

            <section class="airport-map" hidden data-map-points="{{.MapJSON}}" data-map-error="{{t "airport.map_unavailable"}}" aria-label="{{t "airport.map_heading"}}">
                <div class="map-toolbar">
                    <h3>{{t "airport.map_heading"}}</h3>
                    <div class="map-zoom-controls">
                        <button type="button" data-map-zoom="1" aria-label="{{t "airport.zoom_in"}}">+</button>
                        <button type="button" data-map-zoom="-1" aria-label="{{t "airport.zoom_out"}}">−</button>
                    </div>
                </div>
                <div class="map-canvas" role="region" aria-label="{{t "airport.map_heading"}}"></div>
                <p class="map-attribution">© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap contributors</a></p>
            </section>

            <div class="results-list">
                {{range .Airports}}
                <div class="airport-result-card" data-action="view-airport" data-code="{{.ICAO}}">
                    <div class="airport-result-header">
                        <div>
                            <h3>{{.ICAO}}{{if .IATA}} / {{.IATA}}{{end}}</h3>
                            <div class="airport-name">{{.Name}}</div>
                        </div>
                        <div class="distance-badge">
                            {{printf "%.2f" .Distance}} {{.DistanceUnit}}
                        </div>
                    </div>
                    <div class="airport-result-details">
                        <span>📍 {{.City}}, {{.Country}}</span>
                        <span>✈️ {{.Elevation}} ft</span>
                        <span>🌐 {{printf "%.4f" .Lat}}, {{printf "%.4f" .Lon}}</span>
                        <a href="https://www.openstreetmap.org/?mlat={{.Lat}}&mlon={{.Lon}}#map=12/{{.Lat}}/{{.Lon}}" target="_blank" rel="noopener">{{t "airport.view_on_map"}}</a>
                    </div>
                </div>
                {{end}}
            </div>
        {{end}}
    </div>
</div>

{{end}}
