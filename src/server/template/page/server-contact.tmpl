{{define "content"}}
<div class="container container-md">
    <header class="page-header">
        <h1 class="page-title">{{t "contact.title"}}</h1>
        <p class="page-lead">{{t "contact.purpose"}}</p>
    </header>

    {{if .SuccessMode}}
    <section class="section-card alert alert-success" aria-labelledby="contact-success">
        <h2 id="contact-success">{{t "contact.success_title"}}</h2>
        <p>{{.StepMessage}}</p>
    </section>
    {{else if .ReviewMode}}
    <section class="section-card" aria-labelledby="contact-review">
        <h2 id="contact-review">{{t "contact.review_title"}}</h2>
        <p>{{t "contact.type_label"}}: <strong>{{t .FormTitle}}</strong></p>
        <p>{{t "contact.email_label"}}: <strong>{{.ReviewEmail}}</strong></p>
        {{if .ReviewSubject}}<p>{{t "contact.subject_label"}}: <strong>{{.ReviewSubject}}</strong></p>{{end}}
        <p>{{t "contact.review_intro"}}</p>
        <form method="post" action="{{path .FormAction}}">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            {{range $key, $value := .ReviewValues}}
                {{if and (ne $key "csrf_token") (ne $key "captcha_id") (ne $key "captcha_answer") (ne $key "captcha") (ne $key "captcha_response") (ne $key "g-recaptcha-response") (ne $key "h-captcha-response") (ne $key "form_token") (ne $key "step") (ne $key "review_token") (ne $key "confirmed")}}
                <input type="hidden" name="{{$key}}" value="{{$value}}">
                {{end}}
            {{end}}
            <input type="hidden" name="step" value="confirm">
            <input type="hidden" name="review_token" value="{{.ReviewToken}}">
            <label class="form-group"><input name="confirmed" type="checkbox" value="true" required> {{t "contact.confirm_statement"}}</label>
            <button class="btn btn-primary" type="submit">{{t "contact.confirm"}}</button>
        </form>
        <form method="post" action="{{path .FormAction}}">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            {{range $key, $value := .ReviewValues}}
                {{if and (ne $key "csrf_token") (ne $key "captcha_id") (ne $key "captcha_answer") (ne $key "captcha") (ne $key "captcha_response") (ne $key "g-recaptcha-response") (ne $key "h-captcha-response") (ne $key "review_token") (ne $key "confirmed")}}
                <input type="hidden" name="{{$key}}" value="{{$value}}">
                {{end}}
            {{end}}
            <input type="hidden" name="step" value="edit">
            <button class="btn btn-secondary" type="submit">{{t "contact.edit"}}</button>
        </form>
    </section>
    {{else if .ShowChooser}}
    <section class="section-card" aria-labelledby="contact-types">
        <h2 id="contact-types">{{t "contact.choose_type"}}</h2>
        <ul class="hub-list">
            {{range .Types}}
            <li class="hub-item"><a class="hub-link" href="{{path (printf "/server/contact%s" .url)}}"><span class="hub-title">{{t .label}}</span></a></li>
            {{end}}
        </ul>
    </section>
    <section class="section-card" aria-labelledby="security-issues">
        <h2 id="security-issues">{{t "contact.security_issues"}}</h2>
        <p>{{t "contact.security_policy_prompt"}} <a href="{{path "/server/security"}}">{{t "contact.security_policy"}}</a>.</p>
    </section>
    <section class="section-card" aria-labelledby="abuse-reports">
        <h2 id="abuse-reports">{{t "contact.abuse_reports"}}</h2>
        <p>{{t "contact.abuse_info"}} {{t "contact.dmca_info"}}{{if .AbuseEmail}} {{tf "contact.email_clause" "email" .AbuseEmail}}{{end}}</p>
    </section>
    {{else}}
    <section class="section-card" aria-labelledby="contact-form-heading">
        <h2 id="contact-form-heading">{{t .FormTitle}}</h2>
        {{if .ValidationMessage}}<p class="alert alert-danger" role="alert">{{.ValidationMessage}}</p>{{end}}
        <form method="post" action="{{path .FormAction}}" data-captcha="{{.CaptchaType}}">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="type" value="{{.FormType}}">
            <input type="hidden" name="step" value="submit">
            <input type="hidden" name="form_token" value="{{.FormToken}}">
            {{if .SecurityMode}}<input type="hidden" name="security_id" value="{{.SecurityID}}">{{end}}
            <div class="honeypot" aria-hidden="true"><label for="contact-website">{{t "contact.honeypot_label"}}</label><input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off"></div>

            {{range .FormFields}}
            <div class="form-group">
                {{$field := .}}
                <label for="contact-{{.name}}">{{t .label}} <span>{{if .required}}{{t "contact.required"}}{{else}}{{t "contact.optional"}}{{end}}</span></label>
                {{if eq .name "reported_url"}}<p class="form-help">{{tf "contact.reported_url_help" "fqdn" $.FQDN}}</p>{{end}}
                {{if eq .type "select"}}
                <select class="form-input" id="contact-{{.name}}" name="{{.name}}" {{if .required}}required{{end}}>
                    <option value="">{{t "contact.choose_option"}}</option>
                    {{range .options}}<option value="{{.}}">{{t (printf "contact.%s_%s" $field.name .)}}</option>{{end}}
                </select>
                {{else if eq .type "textarea"}}
                <textarea class="form-input" id="contact-{{.name}}" name="{{.name}}" {{if gt .max_length 0}}maxlength="{{.max_length}}"{{end}} {{if .required}}required{{end}}>{{.value}}</textarea>
                {{else if eq .type "checkbox"}}
                <input id="contact-{{.name}}" name="{{.name}}" type="checkbox" value="true" {{if eq .value "true"}}checked{{end}} {{if .required}}required{{end}}>
                {{else}}
                <input class="form-input" id="contact-{{.name}}" name="{{.name}}" type="{{.type}}" value="{{.value}}" {{if gt .max_length 0}}maxlength="{{.max_length}}"{{end}} {{if .required}}required{{end}}>
                {{end}}
            </div>
            {{end}}

            {{if eq .CaptchaType "simple"}}
            <div class="form-group">
                <label for="contact-captcha">{{t "contact.captcha"}}</label>
                <p id="contact-captcha-question">{{.CaptchaQuestion}}</p>
                <input type="hidden" name="captcha_id" value="{{.CaptchaID}}">
                <input class="form-input" id="contact-captcha" name="captcha_answer" type="text" inputmode="numeric" required>
            </div>
            {{else}}
            {{if eq .CaptchaType "recaptcha"}}<div class="g-recaptcha" data-sitekey="{{.CaptchaSiteKey}}"></div><script src="https://www.google.com/recaptcha/api.js" defer></script>{{end}}
            {{if eq .CaptchaType "hcaptcha"}}<div class="h-captcha" data-sitekey="{{.CaptchaSiteKey}}"></div><script src="https://js.hcaptcha.com/1/api.js" defer></script>{{end}}
            <noscript>
                <div class="form-group">
                    <label for="contact-captcha-fallback">{{t "contact.captcha_fallback"}}: {{.CaptchaQuestion}}</label>
                    <input type="hidden" name="captcha_id" value="{{.CaptchaID}}">
                    <input class="form-input" id="contact-captcha-fallback" name="captcha_answer" type="text" inputmode="numeric" required>
                </div>
            </noscript>
            {{end}}
            <button class="btn btn-primary" type="submit">{{t "contact.send"}}</button>
        </form>
    </section>
    <section class="section-card" aria-labelledby="security-issues">
        <h2 id="security-issues">{{t "contact.security_issues"}}</h2>
        <p>{{t "contact.security_policy_prompt"}} <a href="{{path "/server/security"}}">{{t "contact.security_policy"}}</a>.</p>
    </section>
    {{end}}
</div>
{{end}}
