    <p>{{t "contact.intro_pre"}} <a href="/server/help">{{t "nav.help"}}</a>{{t "contact.intro_post"}}</p>

    <h2>{{t "contact.general_heading"}}</h2>
    <p><a href="mailto:{{.GeneralEmail}}">{{.GeneralEmail}}</a></p>

    <h2>{{t "contact.abuse_heading"}}</h2>
    <p><a href="mailto:{{.AbuseEmail}}">{{.AbuseEmail}}</a></p>

