{{define "content"}}
<div class="container container-md">
    <header class="page-header">
        <nav class="breadcrumb" aria-label="{{t "preferences.breadcrumb_label"}}"><a href="{{path "/server/preferences"}}">{{t "owner_tokens.back"}}</a></nav>
        <h1 class="page-title">{{t "owner_tokens.title"}}</h1>
        <p class="page-lead">{{t "owner_tokens.new_hint"}}</p>
    </header>
    {{if .TokenNotice}}
    <p class="alert alert-success owner-token-flash" id="owner-token-notice" role="status">{{t (printf "owner_tokens.notice_%s" .TokenNotice)}}</p>
    {{end}}
    {{if not .OwnerActive}}
    <div class="owner-token-layout">
        <section class="section-card" aria-labelledby="owner-token-new-heading">
            <h2 id="owner-token-new-heading">{{t "owner_tokens.new_title"}}</h2>
            <p>{{t "owner_tokens.new_hint"}}</p>
            <form method="post" action="{{path "/server/preferences/token/create"}}">
                <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                <button class="btn btn-primary" type="submit">{{t "owner_tokens.create"}}</button>
            </form>
        </section>
        <section class="section-card" aria-labelledby="owner-token-restore-heading">
            <h2 id="owner-token-restore-heading">{{t "owner_tokens.restore_title"}}</h2>
            <form method="post" action="{{path "/server/preferences/token/restore"}}">
                <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                <label for="owner-token-restore">{{t "owner_tokens.primary_label"}}</label>
                <input class="form-input" id="owner-token-restore" name="token" type="password" autocomplete="off" required>
                <button class="btn btn-primary" type="submit">{{t "owner_tokens.restore"}}</button>
            </form>
        </section>
    </div>
    {{else}}
    <div class="owner-token-layout">
        <div class="owner-token-column">
            {{range .Tokens}}
            {{if eq .Kind "primary"}}
            <section class="section-card owner-token-card" id="primary" aria-labelledby="owner-token-primary-heading">
                <h2 id="owner-token-primary-heading">{{t "owner_tokens.primary_label"}}</h2>
                <span class="status-badge status-{{.Status}}">{{t (printf "owner_tokens.status_%s" .Status)}}</span>
                {{if and $.RevealToken (eq $.RevealID .ID)}}
                <p>{{t "owner_tokens.shown_once"}}</p>
                <code class="copy-value">{{$.RevealToken}}</code>
                <button class="copy-btn" type="button" data-action="copy-value" data-copy="{{$.RevealToken}}" data-copied-label="{{t "common.copied"}}" aria-label="{{t "common.copy_to_clipboard"}}">{{t "common.copy"}}</button>
                <span class="copy-feedback" aria-live="polite"></span>
                {{else}}
                <code class="copy-value">{{.Masked}}</code>
                <form method="post" action="{{path "/server/preferences/token/reveal"}}">
                    <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                    <button class="btn btn-secondary" type="submit">{{t "owner_tokens.reveal"}}</button>
                </form>
                {{end}}
                <p>{{tf "owner_tokens.full_access" "resources" $.ResourceLabelPlural}}</p>
                <button class="btn btn-secondary" type="button" popovertarget="owner-primary-rotate-confirm">{{t "owner_tokens.rotate"}}</button>
                <div id="owner-primary-rotate-confirm" class="confirm-popover" popover>
                    <p>{{t "owner_tokens.rotate_confirmation"}}</p>
                    <form method="post" action="{{path "/server/preferences/token/rotate"}}"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><button class="btn btn-danger" type="submit">{{t "owner_tokens.rotate"}}</button><button class="btn btn-secondary" type="button" popovertarget="owner-primary-rotate-confirm" popovertargetaction="hide">{{t "common.cancel"}}</button></form>
                </div>
            </section>
            {{end}}
            {{end}}
            <section class="section-card owner-token-card" aria-labelledby="owner-token-create-linked-heading">
                <h2 id="owner-token-create-linked-heading">{{t "owner_tokens.create_linked"}}</h2>
                <form method="post" action="{{path "/server/preferences/tokens"}}">
                    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                    <label for="owner-token-name">{{t "owner_tokens.name"}}</label>
                    <input class="form-input" id="owner-token-name" name="name" maxlength="64" required>
                    <p class="form-help">{{t "owner_tokens.name_example"}}</p>
                    <label for="owner-token-expiry">{{t "owner_tokens.expiry"}}</label>
                    <select class="form-input" id="owner-token-expiry" name="expiry">
                        <option value="never">{{t "owner_tokens.expiry_never"}}</option>
                        <option value="7d">{{t "owner_tokens.expiry_7d"}}</option>
                        <option value="30d">{{t "owner_tokens.expiry_30d"}}</option>
                        <option value="90d">{{t "owner_tokens.expiry_90d"}}</option>
                        <option value="1y">{{t "owner_tokens.expiry_1y"}}</option>
                        <option value="custom">{{t "owner_tokens.expiry_custom"}}</option>
                    </select>
                    <details class="owner-token-custom-expiry">
                        <summary>{{t "owner_tokens.expiry_custom"}}</summary>
                        <label for="owner-token-expires-on">{{t "owner_tokens.expires_on"}}</label>
                        <input class="form-input" id="owner-token-expires-on" name="expires_on" type="date">
                    </details>
                    <button class="btn btn-primary" type="submit">{{t "owner_tokens.create"}}</button>
                </form>
            </section>
            <section class="section-card owner-token-card" aria-labelledby="owner-token-browser-heading">
                <h2 id="owner-token-browser-heading">{{t "owner_tokens.this_browser"}}</h2>
                <p>{{tf "owner_tokens.browser_hint" "resources" .ResourceLabelPlural}}</p>
                <button class="btn btn-danger-ghost" type="button" popovertarget="owner-token-forget-confirm">{{t "owner_tokens.forget"}}</button>
                <div id="owner-token-forget-confirm" class="confirm-popover" popover><p>{{t "owner_tokens.forget_confirmation"}}</p><form method="post" action="{{path "/server/preferences/token/forget"}}"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><button class="btn btn-danger" type="submit">{{t "owner_tokens.forget"}}</button><button class="btn btn-secondary" type="button" popovertarget="owner-token-forget-confirm" popovertargetaction="hide">{{t "common.cancel"}}</button></form></div>
            </section>
            <section class="section-card owner-token-card" aria-labelledby="owner-token-revoke-primary-heading">
                <h2 id="owner-token-revoke-primary-heading">{{t "owner_tokens.revoke_primary_title"}}</h2>
                <p>{{tf "owner_tokens.revoke_primary_counts" "linked" .LinkedCount "resources" .ResourceCount "resource_label" .ResourceLabelPlural}}</p>
                <button class="btn btn-danger" type="button" popovertarget="owner-token-primary-revoke-confirm">{{t "owner_tokens.revoke_primary"}}</button>
                <div id="owner-token-primary-revoke-confirm" class="confirm-popover" popover>
                    <form method="post" action="{{path "/server/preferences/token/revoke"}}">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <label for="owner-token-primary-confirm">{{tf "owner_tokens.revoke_primary_confirm" "last4" .PrimaryLast4}}</label>
                        <input class="form-input" id="owner-token-primary-confirm" name="confirm" maxlength="4" autocomplete="off" required>
                        <button class="btn btn-danger" type="submit">{{t "owner_tokens.revoke_primary"}}</button>
                        <button class="btn btn-secondary" type="button" popovertarget="owner-token-primary-revoke-confirm" popovertargetaction="hide">{{t "common.cancel"}}</button>
                    </form>
                </div>
            </section>
        </div>
        <section class="section-card owner-token-linked" aria-labelledby="owner-token-linked-heading">
            <h2 id="owner-token-linked-heading">{{tf "owner_tokens.linked_heading" "count" .LinkedCount}}</h2>
            {{ $linked := false }}
            <ul class="owner-linked-token-list">
            {{range .Tokens}}
            {{if eq .Kind "linked"}}
            {{ $linked = true }}
            <li class="owner-linked-token" id="token-{{.ID}}">
                <h3>{{.Name}}</h3>
                <span class="status-badge status-{{.Status}}">{{t (printf "owner_tokens.status_%s" .Status)}}</span>
                {{if and $.RevealToken (eq $.RevealID .ID)}}
                <p>{{t "owner_tokens.shown_once"}}</p>
                <code class="copy-value">{{$.RevealToken}}</code>
                <button class="copy-btn" type="button" data-action="copy-value" data-copy="{{$.RevealToken}}" data-copied-label="{{t "common.copied"}}" aria-label="{{t "common.copy_to_clipboard"}}">{{t "common.copy"}}</button>
                <span class="copy-feedback" aria-live="polite"></span>
                {{else}}
                <code class="copy-value">{{.Masked}}</code>
                {{end}}
                <dl>
                    <dt>{{t "owner_tokens.created"}}</dt><dd>{{.CreatedLabel}}</dd>
                    <dt>{{t "owner_tokens.last_used"}}</dt><dd>{{if .LastUsedLabel}}{{.LastUsedLabel}}{{else}}{{t "common.none"}}{{end}}</dd>
                    <dt>{{t "owner_tokens.expires"}}</dt><dd>{{if .ExpiresLabel}}{{.ExpiresLabel}}{{else}}{{t "owner_tokens.expiry_never"}}{{end}}</dd>
                </dl>
                <div class="owner-token-actions">
                    <form method="post" action="{{path (printf "/server/preferences/tokens/%s/reveal" .ID)}}"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><button class="btn btn-secondary" type="submit">{{t "owner_tokens.reveal"}}</button></form>
                    <button class="btn btn-secondary" type="button" popovertarget="owner-linked-rotate-confirm-{{.ID}}">{{t "owner_tokens.rotate"}}</button>
                    <div id="owner-linked-rotate-confirm-{{.ID}}" class="confirm-popover" popover><p>{{t "owner_tokens.rotate_confirmation"}}</p><form method="post" action="{{path (printf "/server/preferences/tokens/%s/rotate" .ID)}}"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><button class="btn btn-danger" type="submit">{{t "owner_tokens.rotate"}}</button><button class="btn btn-secondary" type="button" popovertarget="owner-linked-rotate-confirm-{{.ID}}" popovertargetaction="hide">{{t "common.cancel"}}</button></form></div>
                    <details>
                        <summary>{{t "common.edit"}}</summary>
                        <form method="post" action="{{path (printf "/server/preferences/tokens/%s/update" .ID)}}">
                            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                            <label for="owner-token-name-{{.ID}}">{{t "owner_tokens.name"}}</label>
                            <input class="form-input" id="owner-token-name-{{.ID}}" name="name" value="{{.Name}}" maxlength="64" required>
                            <label for="owner-token-expiry-{{.ID}}">{{t "owner_tokens.expiry"}}</label>
                            <select class="form-input" id="owner-token-expiry-{{.ID}}" name="expiry"><option value="never" {{if eq .ExpiryChoice "never"}}selected{{end}}>{{t "owner_tokens.expiry_never"}}</option><option value="7d">{{t "owner_tokens.expiry_7d"}}</option><option value="30d">{{t "owner_tokens.expiry_30d"}}</option><option value="90d">{{t "owner_tokens.expiry_90d"}}</option><option value="1y">{{t "owner_tokens.expiry_1y"}}</option><option value="custom" {{if eq .ExpiryChoice "custom"}}selected{{end}}>{{t "owner_tokens.expiry_custom"}}</option></select>
                            <details class="owner-token-custom-expiry" {{if eq .ExpiryChoice "custom"}}open{{end}}><summary>{{t "owner_tokens.expiry_custom"}}</summary><label for="owner-token-expires-on-{{.ID}}">{{t "owner_tokens.expires_on"}}</label><input class="form-input" id="owner-token-expires-on-{{.ID}}" name="expires_on" type="date" value="{{.ExpiresOnInput}}"></details>
                            <button class="btn btn-primary" type="submit">{{t "common.save"}}</button>
                        </form>
                    </details>
                    <button class="btn btn-danger" type="button" popovertarget="owner-linked-revoke-confirm-{{.ID}}">{{t "owner_tokens.revoke"}}</button>
                    <div id="owner-linked-revoke-confirm-{{.ID}}" class="confirm-popover" popover><p>{{t "owner_tokens.revoke_confirmation"}}</p><form method="post" action="{{path (printf "/server/preferences/tokens/%s/revoke" .ID)}}"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><button class="btn btn-danger" type="submit">{{t "owner_tokens.revoke"}}</button><button class="btn btn-secondary" type="button" popovertarget="owner-linked-revoke-confirm-{{.ID}}" popovertargetaction="hide">{{t "common.cancel"}}</button></form></div>
                </div>
            </li>
            {{end}}
            {{end}}
            </ul>
            {{if not $linked}}<p>{{t "owner_tokens.no_linked"}}</p><p>{{t "owner_tokens.mcp_hint"}}</p>{{end}}
        </section>
    </div>
    {{end}}
</div>
{{end}}
